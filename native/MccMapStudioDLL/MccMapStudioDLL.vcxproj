  <!--
    Hot-reload staging copy. Writes a fresh copy of HaloMapStudioDLL.dll to
    $(SolutionDir)staging\ alongside a plain-text timestamp so the running
    HaloMapStudio.exe can pull the latest build without holding a file lock
    on the build output. The viewer's Hot Reload button:
      1. invokes MSBuild on this vcxproj (produces fresh bin output + staging copy)
      2. calls native ZH_MMP_PrepareUnload + FreeLibrary
      3. copies staging\HaloMapStudioDLL.dll over its own bundle copy
      4. LoadLibraryW the bundle copy again
    Staging is never locked because nothing loads from there directly.
  -->
  <Target Name="CopyToStaging" AfterTargets="Build">
    <MakeDir Directories="$(SolutionDir)staging" Condition="!Exists('$(SolutionDir)staging')" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(SolutionDir)staging"
      SkipUnchangedFiles="false"
      Condition="Exists('$(TargetPath)')" />
    <WriteLinesToFile
      File="$(SolutionDir)staging\HaloMapStudioDLL.dll.timestamp.txt"
      Lines="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))"
      Overwrite="true"
      Condition="Exists('$(TargetPath)')" />
    <Message Importance="high" Text="Staged HaloMapStudioDLL.dll to $(SolutionDir)staging\" Condition="Exists('$(TargetPath)')" />
  </Target>
